FAB_INSIGHTS_API_KEY=put-your-api-key-here
REFRESH_TOKEN=change-this-token

# Report generation defaults
REPORT_START_DATE=2026-05-01
# REPORT_END_DATE defaults to today if omitted
SKIP_IMAGES=true
CUSTOM_CARDS_FILE=resources/OMN_Draft_2.txt

# Replit-hosted daily scheduler
ENABLE_SCHEDULER=true
SCHEDULER_TIMEZONE=Europe/Madrid
CRON_HOUR=8
CRON_MINUTE=5
RUN_ON_START=false
